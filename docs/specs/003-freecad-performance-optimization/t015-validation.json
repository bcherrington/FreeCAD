  "numeric_policy": {
    "radices": "Archive fields use explicit decimal child SIDs and hexadecimal mapped-prefix/index/postfix/SID fields; no format change.",
    "legacy_values": "Leading C whitespace, one optional sign, optional 0x/0X for base16 with following hex digit, longest numeric prefix, no-digits=0, and LONG_MIN/LONG_MAX saturation match legacy strtol. Signed accumulation replaced with checked unsigned magnitude; safe LONG_MIN construction.",
    "bounds": "Only view bytes inspected, including non-NUL-terminated spans; digit conversion is ASCII, whitespace classified through unsigned char. No allocation in conversion. Standard archive extraction still separates whitespace before dot-tokenization.",
    "invalid_metadata": "Negative counts, nonpositive MapCount, unrepresentable child interval/cumulative size, and mapped element indices outside 0..INT_MAX raise Base::RuntimeError before arithmetic/narrowing/allocation. Zero mapped index remains accepted and serializes without a numeric suffix. This enforces existing representable-domain preconditions rather than changing valid writer output.",
    "context": "Saturated missing SIDs remain ignored with existing warning policy; invalid postfix index remains warned/omitted; invalid name table index remains rejected. No silently wrapped alias to a valid ID/index.",
    "ownership": "Colon names are compacted before the temporary prefix table dies; zero mapped index otherwise leaves raw QByteArray borrowed from that table. Positive index already owns storage; compact is a no-op there.",
    "limits": "No general archive memory budget or bad_alloc recovery policy; no full locale-specific non-ASCII numeric syntax, Windows/LLP64 or full CAD-reference qualification claimed."
  },
