      "source_text": "#include \"App/ElementMapRestore.h\"\n#include <climits>\n#include <cstdlib>\n#include <memory>\n#include <string>\n#include <vector>\n\nint main()\n{\n    for (int base : {10, 16}) {\n        std::vector<std::string> tokens {\n            std::to_string(LONG_MIN), std::to_string(LONG_MAX),\n            \"9223372036854775808\", \"-9223372036854775809\",\n            \"2147483648\", \"-2147483649\", \"0x7fffffffffffffff\", \"-0x8000000000000000\",\n            \"+0X12junk\", \" \\t-12tail\", \"\", \"+\", \"0x\", \"0xg\",\n            std::string(65536, '9'), \"-\" + std::string(65536, 'f'),\n            std::string(65536, '0') + \"1\"\n        };\n        for (const auto& token : tokens) {\n            const auto actual = Data::detail::parseRestoreLong(token, base);\n            if (actual != std::strtol(token.c_str(), nullptr, base)) return 2;\n        }\n        auto bytes = std::make_unique<char[]>(3);\n        bytes[0] = ' '; bytes[1] = '-'; bytes[2] = '1';\n        if (Data::detail::parseRestoreLong({bytes.get(), 3}, base) != -1) return 3;\n        if (Data::detail::parseRestoreLong({bytes.get()+3, 0}, base) != 0) return 4;\n    }\n}\n",
      "compiler_command": "pixi run --locked clang++ -std=c++17 -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -I src /tmp/spec003-t015-sanitizer-probe.cpp -o /tmp/spec003-t015-sanitizer",
      "run_command": "pixi run --locked env UBSAN_OPTIONS=print_stacktrace=1 timeout 30s /tmp/spec003-t015-sanitizer",
      "scope": "Exact production private header only; 65536-byte tokens, boundaries and bounded views; not sanitized whole FreeCAD/Qt libraries. Exit zero, no diagnostic."
    }
